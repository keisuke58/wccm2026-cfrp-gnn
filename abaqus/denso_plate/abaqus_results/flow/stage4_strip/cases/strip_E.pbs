#!/bin/bash
# GUIDE section 20 step 2: strip variants, one change each, serial, 150 s each, all five at once
#PBS -N oims_E
#PBS -l nodes=1:ppn=5
#PBS -l walltime=00:30:00
#PBS -j oe
B=/tmp/pm$(id -u); mkdir -p $B; chmod 700 $B; export XDG_RUNTIME_DIR=$B
P="podman --root $B/storage --runroot $B/run --events-backend=file --cgroup-manager=cgroupfs --storage-opt overlay.ignore_chown_errors=true"
echo "host $(hostname) start $(date)"
$P image exists localhost/of7-keepid || $P load -q -i $HOME/flow_sim/img/of7-keepid.tar
for v in E_b E_c E_d M1 M2; do
  $P run --rm --network=host --userns=keep-id --user $(id -u):$(id -g) -e HOME=/tmp -e TRIAL_SEC=150 \
    -v $HOME/flow_sim/runs/strip_$v:/case -v $HOME/flow_sim/user:/foamuser -w /case --entrypoint /bin/bash localhost/of7-keepid -c '
    source /opt/openfoam7/etc/bashrc
    export WM_PROJECT_USER_DIR=/foamuser FOAM_USER_APPBIN=/foamuser/bin FOAM_USER_LIBBIN=/foamuser/lib
    export PATH=/foamuser/bin:$PATH LD_LIBRARY_PATH=/foamuser/lib:$LD_LIBRARY_PATH
    ./Atrial' > $HOME/flow_sim/runs/strip_$v/run.out 2>&1 &
done
wait
echo "end $(date)"
